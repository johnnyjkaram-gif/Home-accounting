# PostgreSQL connection string.
# If you use the included docker-compose.yml as-is, this value already matches it.
DATABASE_URL="postgresql://homeacct:homeacct_dev_password@localhost:5432/home_accounting?schema=public"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enable live exchange-rate fetching in Settings > Currency.
# Leave blank to use manual exchange rates only (fully supported without this).
# Get a free key at https://www.exchangerate-api.com/ (or swap the fetch call
# in src/lib/exchange-rate-api.ts for any provider you prefer).
EXCHANGE_RATE_API_KEY=""

# Protects /api/cron/recurring (which materializes due recurring income/expense
# transactions) from being called by anyone but your scheduler. Generate with:
# openssl rand -hex 20
CRON_SECRET=""
